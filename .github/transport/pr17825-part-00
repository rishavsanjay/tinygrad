+  def iter_sig(signature:tuple[tuple[str|None, int, DType, tuple, AddrSpace], ...], offset:int=0) \
+    -> Generator[tuple[int, DType, AddrSpace], None, None]:
+    for _,_,dt,_,addrspace in signature:
+      align, size = (dt.itemsize, dt.itemsize) if addrspace is AddrSpace.ALU else (8, 8)
+      yield (offset:=round_up(offset, align)), dt, addrspace
+      offset += size
+
+  @staticmethod
+  def merge_args(signature:tuple[tuple[str|None, int, DType, tuple, AddrSpace], ...], buffers:Sequence, values:Sequence) -> list:
+    return [values[slot] if addrspace is AddrSpace.ALU else buffers[slot] for _,slot,_,_,addrspace in signature]
 
